<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <custom-type type-id="RentalUnit">
        <display-name xml:lang="x-default">Rental unit</display-name>
        <description xml:lang="x-default">One physical piece that can be rented, keyed by its tag number.</description>
        <staging-mode>no-staging</staging-mode>
        <storage-scope>site</storage-scope>
        <key-definition attribute-id="key">
            <display-name xml:lang="x-default">Unit tag</display-name>
            <type>string</type>
            <min-length>1</min-length>
        </key-definition>
        <attribute-definitions>
            <attribute-definition attribute-id="productID">
                <display-name xml:lang="x-default">Product ID (the variant, so the size is fixed)</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="status">
                <display-name xml:lang="x-default">Status (ACTIVE, MAINTENANCE, RETIRED)</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="notes">
                <display-name xml:lang="x-default">Condition notes</display-name>
                <type>text</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
        </attribute-definitions>
        <group-definitions>
            <attribute-group group-id="RentalUnit">
                <display-name xml:lang="x-default">Rental unit</display-name>
                <attribute attribute-id="productID"/>
                <attribute attribute-id="status"/>
                <attribute attribute-id="notes"/>
            </attribute-group>
        </group-definitions>
    </custom-type>
    <custom-type type-id="RentalUnitDay">
        <display-name xml:lang="x-default">Rental unit day</display-name>
        <description xml:lang="x-default">Claims one calendar day of one unit. The key is unit|yyyy-MM-dd, so two bookings can never hold the same day.</description>
        <staging-mode>no-staging</staging-mode>
        <storage-scope>site</storage-scope>
        <key-definition attribute-id="key">
            <display-name xml:lang="x-default">Unit and day</display-name>
            <type>string</type>
            <min-length>1</min-length>
        </key-definition>
        <attribute-definitions>
            <attribute-definition attribute-id="unitID">
                <display-name xml:lang="x-default">Unit tag</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="day">
                <display-name xml:lang="x-default">Day (yyyy-MM-dd)</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="bookingNo">
                <display-name xml:lang="x-default">Booking number</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
            <attribute-definition attribute-id="holdExpiresAt">
                <display-name xml:lang="x-default">Cart hold expires at (empty once the booking is confirmed)</display-name>
                <type>datetime</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
        </attribute-definitions>
        <group-definitions>
            <attribute-group group-id="RentalUnitDay">
                <display-name xml:lang="x-default">Rental unit day</display-name>
                <attribute attribute-id="unitID"/>
                <attribute attribute-id="day"/>
                <attribute attribute-id="bookingNo"/>
                <attribute attribute-id="holdExpiresAt"/>
            </attribute-group>
        </group-definitions>
    </custom-type>
